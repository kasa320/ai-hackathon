# .env にコピーして使う（.env はコミットしない）。

# サーバー
ADDR=:8080
DB_PATH=data/app.db
FRONTEND_DIR=src/frontend

# エージェント：fake（LLM を呼ばない）または llm
AGENT_MODE=fake

# OrcaRouter（AGENT_MODE=llm のとき必須）
ORCAROUTER_API_KEY=
ORCAROUTER_BASE_URL=https://api.orcarouter.ai/v1
ORCAROUTER_MODEL=orcarouter/auto

# Discord（ログインと通知）
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_REDIRECT_URL=http://localhost:8080/api/auth/callback
DISCORD_BOT_TOKEN=

# セッション Cookie の署名用（ランダムな長い文字列）
SESSION_SECRET=
