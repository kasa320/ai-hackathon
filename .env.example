# .env にコピーして使う（.env はコミットしない）。

# サーバー
ADDR=:24680
DB_PATH=data/app.db
FRONTEND_DIR=src/frontend
# 通知のリンクと Origin 検証の基点。https なら Cookie に Secure を付ける
PUBLIC_BASE_URL=http://localhost:24680
# 1 にすると開発・デモ用 API（/api/dev/*）と障害注入を有効にする。本番では設定しない
DEV_MODE=

# エージェント：fake（LLM を呼ばない）または llm
AGENT_MODE=fake

# OrcaRouter（AGENT_MODE=llm のとき必須）
ORCAROUTER_API_KEY=
ORCAROUTER_BASE_URL=https://api.orcarouter.ai/v1
ORCAROUTER_MODEL=orcarouter/auto
# エージェントごとのモデル（空なら ORCAROUTER_MODEL）
# 案（日時・進行・担当）を考えるモデル
ORCAROUTER_PLANNER_MODEL=
# Web・Discord の自由文から参加条件を取り出すモデル（Discord の1往復は60秒で打ち切るので速いものを選ぶ）
ORCAROUTER_INTERPRETER_MODEL=
# LLM 呼び出し1回の待ち時間の上限（秒、1〜600）
ORCAROUTER_TIMEOUT_SECONDS=180
# 目次の Web 検索に使う検索付きモデル（空なら Web 検索をせず、画像の提出を依頼する）
ORCAROUTER_SEARCH_MODEL=
# 目次画像の書き写しに使うモデル（空なら ORCAROUTER_MODEL）
ORCAROUTER_VISION_MODEL=

# Discord（ログインと通知）
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_REDIRECT_URL=http://localhost:24680/api/auth/callback
# Bot の常駐（DM での対話・本人宛て通知の DM）に必要。未設定なら通知はログに出すだけ
DISCORD_BOT_TOKEN=
# DM が使えないときの退避先と、全員宛ての連絡の送り先。未設定なら本人宛ての DM だけを送る
DISCORD_CHANNEL_ID=

# セッション Cookie の署名用（ランダムな長い文字列）
SESSION_SECRET=
